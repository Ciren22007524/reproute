// GitHub Codespaces / VS Code Dev Containers 設定
// https://containers.dev/implementors/json_reference/
{
  "name": "RepRoute",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  // 建立容器時：啟用 corepack（依 package.json 的 packageManager 使用 pnpm）並安裝套件
  "postCreateCommand": "sudo corepack enable && corepack install && pnpm install",

  "forwardPorts": [9200, 8787],
  "portsAttributes": {
    "9200": { "label": "Quasar dev (PWA)", "onAutoForward": "openBrowser" },
    "8787": { "label": "Wrangler (Worker + API)", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vue.volar",
        "editorconfig.editorconfig",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "usernamehw.errorlens",
        "eamodio.gitlens",
        "yoavbls.pretty-ts-errors"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
