{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reproute",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Quasar PWA 打包輸出
    "directory": "./dist/pwa",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 只有 /api/* 會進 Hono，其他路徑直接回傳靜態檔
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
  // 之後需要同步紀錄時再開：
  // "d1_databases": [{ "binding": "DB", "database_name": "reproute", "database_id": "<填入>" }]
}
