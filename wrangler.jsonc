{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reproute",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Quasar PWA 打包輸出
    "directory": "./dist/pwa",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 只有 /api/* 會進 Hono，其他路徑直接回傳靜態檔
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // 正式站需由使用者在 Cloudflare 設定 reproute.cirenjhong.com，並完成 Access 切換。
  // 缺少設定時受保護 API 一律拒絕請求。
  "vars": {
    "AUTH_ISSUER": "https://auth.cirenjhong.com",
    "AUTH_JWKS_URL": "https://auth.cirenjhong.com/jwks",
    "AUTH_AUDIENCE": "reproute",
    "AUTH_TOKEN_HEADER": "Authorization",
  },
  // 之後需要同步紀錄時再開：
  // "d1_databases": [{ "binding": "DB", "database_name": "reproute", "database_id": "<填入>" }]
}
