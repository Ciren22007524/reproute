{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reproute",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Quasar PWA 打包輸出
    "directory": "./dist/pwa",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 只有 /api/* 會進 Hono，其他路徑直接回傳靜態檔
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // 登入驗證（見 worker/auth/）。不是機密，但每個 Cloudflare 帳號不同。
  // 沒填時 /api/me 等需要登入的 API 一律回 500（不會變成公開）。
  // 換成自己的登入服務（docs/auth-service.md）時，只要改這幾個值。
  "vars": {
    // Zero Trust → Settings → Custom Pages 或 General 的「Team domain」
    "AUTH_ISSUER": "https://ciren22007524.cloudflareaccess.com",
    "AUTH_JWKS_URL": "https://ciren22007524.cloudflareaccess.com/cdn-cgi/access/certs",
    // Zero Trust → Access → Applications → reproute → Overview 的「Application Audience (AUD) Tag」
    "AUTH_AUDIENCE": "c1299dedeba5a5a7f611a241cf1529e42e99f4bd0cfde2ce70cf7df549ed6c62",
    "AUTH_TOKEN_HEADER": "Cf-Access-Jwt-Assertion",
  },
  // 之後需要同步紀錄時再開：
  // "d1_databases": [{ "binding": "DB", "database_name": "reproute", "database_id": "<填入>" }]
}
