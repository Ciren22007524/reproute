{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reproute",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // 一般變數由 Cloudflare 後台管理，部署時保留；不要在 vars 重複宣告同名值。
  "keep_vars": true,
  "assets": {
    // Quasar PWA 打包輸出
    "directory": "./dist/pwa",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 只有 /api/* 會進 Hono，其他路徑直接回傳靜態檔
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // AUTH_* 等執行期變數：Cloudflare → Worker → Settings → Variables and Secrets。
  // 本機用 .dev.vars（見 .dev.vars.example）；缺少驗證設定時 API 仍拒絕存取。
  // 之後需要同步紀錄時再開：
  // "d1_databases": [{ "binding": "DB", "database_name": "reproute", "database_id": "<填入>" }]
}
